# DEBUT BLOCAGE AVANT CPANEL
# Retirer ce bloc seulement apres avoir configure le mot de passe dans cPanel.
# Voir INSTALLATION-CPANEL.txt a la racine du dossier FTP.
<RequireAll>
  Require all denied
</RequireAll>
# FIN BLOCAGE AVANT CPANEL

# DEBUT PREPRODUCTION NOINDEX - retirer ce bloc lors du lancement public.
<IfModule mod_headers.c>
  Header always set X-Robots-Tag "noindex, nofollow"
</IfModule>
# FIN PREPRODUCTION NOINDEX

Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
  RewriteEngine On

  # HTTPS sur le domaine public, en tenant compte du proxy o2switch.
  RewriteCond %{HTTP_HOST} ^(www\.)?leveildelo\.ch$ [NC]
  RewriteCond %{HTTP:X-Forwarded-Proto} !^https$ [NC]
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # Une seule adresse pour l'accueil : /index.php et /index.html mènent à /
  RewriteCond %{THE_REQUEST} \s/+([^?\s]*)index\.(php|html)[\s?] [NC]
  RewriteRule ^index\.(php|html)$ /%1 [R=301,L]
  RewriteCond %{THE_REQUEST} \s/+([^?\s]*)mentions-legales\.html[\s?] [NC]
  RewriteRule ^mentions-legales\.html$ /%1mentions-legales.php [R=301,L]

  # Adresses courtes des deux pages ; les anciens liens PHP avec ancre restent valides.
  RewriteRule ^(mentions-legales|confidentialite)$ mentions-legales.php [L]

  # Anciennes adresses : conserver les paramètres et la méthode du formulaire d'annulation.
  RewriteCond %{THE_REQUEST} \s/+([^?\s]*)(annuler|bientot)\.php[\s?] [NC]
  RewriteRule ^(annuler|bientot)\.php$ /%1%2 [R=308,L]
  RewriteRule ^(annuler|bientot)$ $1.php [L]

  # robots.txt et sitemap.xml sont générés en PHP à partir du domaine de config.php
  RewriteRule ^robots\.txt$ robots.php [L]
  RewriteRule ^sitemap\.xml$ sitemap.php [L]

  # Code interne, scripts en ligne de commande, jetons et fichiers de travail
  RewriteRule ^(app|bin|storage|tests|textes|php)(/|$) - [F,L,NC]
  RewriteRule (^|/)\.(?!well-known(/|$)) - [F,L]
  RewriteRule (^|/)charte-graphique\.txt$ - [F,L,NC]
</IfModule>

# CSS et JS versionnés par ?v= ; polices versionnées par leur nom de fichier.
<IfModule mod_mime.c>
  AddType font/woff2 .woff2
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
</IfModule>
